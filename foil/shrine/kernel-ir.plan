; foil kernel IR (ShrineGFX Slice 5, Gap 19).
;
; The kernel itself becomes a carrier: NE.8d.1's tiny predicated atom
; set as data, generated by law and interpreted by law — the audit
; tier (SSH F.5).  Gap 20 lowers the same IR to MSL; no kernel ever
; has a second source of truth.
;
; Scalars are zigzag-encoded signed integers (0,-1,1,-2,2 ↔ 0,1,2,3,4):
; the differential fixtures choose small-integer test vectors on which
; f32 GPU arithmetic is EXACT, so the audit tier needs no soft-float —
; float-domain agreement stays the GPU/CPU differential's job.
;
; A step is a 5-row [kind dest a b c]; operand refs pack as 4*v + k
; with k: 0 const (v = zigzag literal) | 1 register | 2 tid.
; Step kinds:
;   0 mov   dest ← a
;   1 load  dest ← B[b] of buffer a (a const-packed buffer slot)
;   2 store B[b] of buffer a ← c
;   3 add   dest ← a + b        4 mul  dest ← a * b
;   5 neg   dest ← -a           6 cge  dest ← (a >= b) ? 1 : 0
;   7 sel   dest ← a ? b : c    8 retif: stop this thread when a ≠ 0
; Buffers carry a per-thread stride (0 = shared): index = tid*stride+j,
; the root-slot indirection every lowering shares.  Lists are cell/0
; (cell is an under-applied law; Ix 0/1 are head/tail).
;
; kernel-ir carrier: (kernel-ir steps nsteps strides nregs k) — steps a
; row of step-rows, strides a row of per-buffer strides.
;
; Run:  build/debug/bin/wisp foil/shrine kernel-ir main
; Output: two pure-digit lines — the row-0 and row-1 output checksums
; (sum (k+1)*zz(out[k]), traced *256+2 so the printer picks decimal).

; ── B-op wrappers ──────────────────────────────────────────────────────

(#bind Add (#pin (#law "Add" (Add a b) ((#pin "B") ("Add" a b)))))
(#bind Sub (#pin (#law "Sub" (Sub a b) ((#pin "B") ("Sub" a b)))))
(#bind Mul (#pin (#law "Mul" (Mul a b) ((#pin "B") ("Mul" a b)))))
(#bind Div (#pin (#law "Div" (Div a b) ((#pin "B") ("Div" a b)))))
(#bind Mod (#pin (#law "Mod" (Mod a b) ((#pin "B") ("Mod" a b)))))
(#bind Rsh (#pin (#law "Rsh" (Rsh a b) ((#pin "B") ("Rsh" a b)))))
(#bind Dec (#pin (#law "Dec" (Dec a) ((#pin "B") ("Dec" a)))))
(#bind Ifz (#pin (#law "Ifz" (Ifz c t e) ((#pin "B") ("Ifz" c t e)))))
(#bind Le (#pin (#law "Le" (Le a b) ((#pin "B") ("Le" a b)))))
(#bind Row (#pin (#law "Row" (Row z n l) ((#pin "B") ("Row" z n l)))))
(#bind Ix (#pin (#law "Ix" (Ix i r) ((#pin "B") ("Ix" i r)))))
(#bind Up (#pin (#law "Up" (Up i v r) ((#pin "B") ("Up" i v r)))))
(#bind Trace (#pin (#law "Trace" (Trace v k) ((#pin "B") ("Trace" v k)))))

; cons cells as under-applied laws (foil modules have no [..] prelude)
(#bind cell (#pin (#law "cell" (cell h t k) 1)))
(#bind hd (#pin (#law "hd" (hd l) (Ix 0 l))))
(#bind tl (#pin (#law "tl" (tl l) (Ix 1 l))))

; ── Zigzag signed arithmetic ───────────────────────────────────────────

(#bind zz-enc
  (#pin (#law "zz-enc" (zz-enc s m)
    (Ifz m 0 (Ifz s (Mul 2 m) (Dec (Mul 2 m)))))))

(#bind zz-sgn (#pin (#law "zz-sgn" (zz-sgn z) (Mod z 2))))
(#bind zz-mag (#pin (#law "zz-mag" (zz-mag z) (Div (Add z 1) 2))))

(#bind zz-neg
  (#pin (#law "zz-neg" (zz-neg z)
    (zz-enc (Ifz (zz-sgn z) 1 0) (zz-mag z)))))

(#bind zz-add
  (#pin (#law "zz-add" (zz-add a b)
    sa(zz-sgn a) sb(zz-sgn b) ma(zz-mag a) mb(zz-mag b)
    (Ifz (Sub sa sb)
      (Ifz (Sub sb sa)
        (zz-enc sa (Add ma mb))          ; same sign
        (Ifz (Le mb ma)                  ; sa<sb: a plus, b minus
          (zz-enc 1 (Sub mb ma))         ; |b| > |a|: minus wins
          (zz-enc 0 (Sub ma mb))))
      (Ifz (Le ma mb)                    ; sa>sb: a minus, b plus
        (zz-enc 1 (Sub ma mb))           ; |a| > |b|: minus wins
        (zz-enc 0 (Sub mb ma)))))))

(#bind zz-mul
  (#pin (#law "zz-mul" (zz-mul a b)
    (zz-enc (Mod (Add (zz-sgn a) (zz-sgn b)) 2)
            (Mul (zz-mag a) (zz-mag b))))))

(#bind zz-ge
  (#pin (#law "zz-ge" (zz-ge a b)
    d(zz-add a (zz-neg b))
    (Ifz (zz-sgn d) 1 0))))

; ── Blade arithmetic (R(3,1,1), duplicated from psa-emitter) ───────────

(#bind bit (#pin (#law "bit" (bit i n) (Mod (Rsh n i) 2))))

(#bind pc
  (#pin (#law "pc" (pc n)
    (Ifz n 0 (Add (Mod n 2) (pc (Div n 2)))))))

(#bind x5
  (#pin (#law "x5" (x5 a b)
    (Ifz (Add a b) 0
      (Add (Mod (Add (Mod a 2) (Mod b 2)) 2)
           (Mul 2 (x5 (Div a 2) (Div b 2))))))))

(#bind inv-go
  (#pin (#law "inv-go" (inv-go a b j)
    (Ifz (Sub 5 j) 0
      (Add (Mul (bit j b) (pc (Rsh a (Add j 1))))
           (inv-go a b (Add j 1)))))))

(#bind inv (#pin (#law "inv" (inv a b) (inv-go a b 0))))
(#bind comp (#pin (#law "comp" (comp a) (Sub 31 a))))
(#bind par (#pin (#law "par" (par n) (Mod n 2))))

(#bind gp-sgn
  (#pin (#law "gp-sgn" (gp-sgn a b)
    (Ifz (Mul (bit 4 a) (bit 4 b))
      (Ifz (par (Add (inv a b) (Mul (bit 0 a) (bit 0 b)))) 1 2)
      0))))

(#bind rsgn (#pin (#law "rsgn" (rsgn a) (par (inv a (comp a))))))
(#bind lsgn (#pin (#law "lsgn" (lsgn a) (par (inv (comp a) a)))))

(#bind ap-sgn
  (#pin (#law "ap-sgn" (ap-sgn a b)
    g(gp-sgn (comp a) (comp b))
    (Ifz g 0
      (Ifz (par (Add (Add (Sub g 1) (Add (rsgn a) (rsgn b)))
                     (lsgn (x5 a b))))
        1 2)))))

(#bind ar-sgn
  (#pin (#law "ar-sgn" (ar-sgn i)
    ag(Sub 5 (pc i))
    (Ifz (par (Div (Mul ag (Dec ag)) 2)) 1 2))))

; ── Step and ref constructors ──────────────────────────────────────────

(#bind rc (#pin (#law "rc" (rc v) (Mul 4 v))))          ; const ref
(#bind rr (#pin (#law "rr" (rr n) (Add 1 (Mul 4 n)))))  ; register ref
(#bind step
  (#pin (#law "step" (step kind dest a b c)
    (Row 0 5 (cell kind (cell dest (cell a (cell b (cell c 0)))))))))

(#bind lweld
  (#pin (#law "lweld" (lweld a b)
    (Ifz a b (cell (hd a) (lweld (tl a) b))))))

(#bind llen
  (#pin (#law "llen" (llen l) (Ifz l 0 (Add 1 (llen (tl l)))))))

; ── The PSA sandwich generated as kernel-ir ────────────────────────────
;
; Buffers: 0 = m (shared, 32) | 1 = x (per-thread, 32) | 2 = out
; (per-thread, 32) | 3 = scratch (per-thread, 32).  Registers:
; 0 = accumulator, 1 = product, 2/3 = load temps.
; Phase A: scratch[k] = sum_i apsgn(i,j)*A[i]*B[j], j = x5(i, comp k).
; Phase B folds the antireverse sign of m into the pair sign.

(#bind contrib
  (#pin (#law "contrib" (contrib abuf bbuf i j s)
    (Ifz s 0
      (cell (step 1 2 (rc abuf) (rc i) 0)          ; r2 ← A[i]
      (cell (step 1 3 (rc bbuf) (rc j) 0)          ; r3 ← B[j]
      (cell (step 4 1 (rr 2) (rr 3) 0)             ; r1 ← r2*r3
        (Ifz (Sub s 1)
          (cell (step 3 0 (rr 0) (rr 1) 0) 0)      ; acc += r1
          (cell (step 5 1 (rr 1) 0 0)              ; r1 ← -r1
          (cell (step 3 0 (rr 0) (rr 1) 0) 0))))))))))

; sign for one (i,j) pair of a phase; arf folds the antireverse of j
(#bind pair-sgn
  (#pin (#law "pair-sgn" (pair-sgn arf i j)
    s0(ap-sgn i j)
    (Ifz arf s0
      (Ifz s0 0
        (Ifz (Sub (ar-sgn j) 1) s0
          (Ifz (Sub s0 1) 2 1)))))))

(#bind slot-go
  (#pin (#law "slot-go" (slot-go abuf bbuf arf k i)
    j(x5 i (comp k))
    (Ifz (Sub 32 i) 0
      (lweld (contrib abuf bbuf i j (pair-sgn arf i j))
             (slot-go abuf bbuf arf k (Add i 1)))))))

(#bind slot
  (#pin (#law "slot" (slot abuf bbuf obuf arf k)
    (lweld (cell (step 0 0 (rc 0) 0 0) 0)                 ; acc ← 0
      (lweld (slot-go abuf bbuf arf k 0)
             (cell (step 2 0 (rc obuf) (rc k) (rr 0)) 0)))))) ; O[k] ← acc

(#bind phase
  (#pin (#law "phase" (phase abuf bbuf obuf arf k)
    (Ifz (Sub 32 k) 0
      (lweld (slot abuf bbuf obuf arf k)
             (phase abuf bbuf obuf arf (Add k 1)))))))

(#bind sandwich-steps
  (#pin (#law "sandwich-steps" (sandwich-steps z)
    (lweld (phase 0 1 3 0 0) (phase 3 0 2 1 0)))))

(#bind kernel-ir
  (#pin (#law "kernel-ir" (kernel-ir steps nsteps strides nregs k) 1)))

(#bind sandwich-ir
  (#pin (#law "sandwich-ir" (sandwich-ir z)
    l(sandwich-steps 0)
    n(llen l)
    (kernel-ir (Row 0 n l) n
               (Row 0 4 (cell 0 (cell 32 (cell 32 (cell 32 0))))) 4))))

; ── The reference interpreter (the audit tier) ─────────────────────────

(#bind ref-val
  (#pin (#law "ref-val" (ref-val r regs tid)
    k(Mod r 4) v(Div r 4)
    (Ifz k v (Ifz (Sub k 1) (Ix v regs) tid)))))

; execute steps [i..n) for one thread; bufs is a 4-row of value rows.
; Every let is lazy, so untaken branches cost nothing.
(#bind exec
  (#pin (#law "exec" (exec ir bufs regs tid i)
    n(Ix 1 ir)
    st(Ix i (Ix 0 ir))
    kind(Ix 0 st) dest(Ix 1 st)
    a(Ix 2 st) b(Ix 3 st) c(Ix 4 st)
    av(ref-val a regs tid) bv(ref-val b regs tid) cv(ref-val c regs tid)
    bslot(Div a 4)
    off(Mul tid (Ix bslot (Ix 2 ir)))
    buf(Ix bslot bufs)
    lv(Ix (Add off bv) buf)
    sbufs(Up bslot (Up (Add off bv) cv buf) bufs)
    i1(Add i 1)
    (Ifz (Sub n i) bufs
      (Ifz kind
        (exec ir bufs (Up dest av regs) tid i1)
      (Ifz (Sub kind 1)
        (exec ir bufs (Up dest lv regs) tid i1)
      (Ifz (Sub kind 2)
        (exec ir sbufs regs tid i1)
      (Ifz (Sub kind 3)
        (exec ir bufs (Up dest (zz-add av bv) regs) tid i1)
      (Ifz (Sub kind 4)
        (exec ir bufs (Up dest (zz-mul av bv) regs) tid i1)
      (Ifz (Sub kind 5)
        (exec ir bufs (Up dest (zz-neg av) regs) tid i1)
      (Ifz (Sub kind 6)
        (exec ir bufs (Up dest (zz-ge av bv) regs) tid i1)
      (Ifz (Sub kind 7)
        (exec ir bufs (Up dest (Ifz av cv bv) regs) tid i1)
        (Ifz av (exec ir bufs regs tid i1) bufs)))))))))))))

(#bind zeros
  (#pin (#law "zeros" (zeros n) (Ifz n 0 (cell 0 (zeros (Dec n)))))))

(#bind k-run-thread
  (#pin (#law "k-run-thread" (k-run-thread ir bufs tid)
    (exec ir bufs (Row 0 (Ix 3 ir) (zeros (Ix 3 ir))) tid 0))))

(#bind k-run
  (#pin (#law "k-run" (k-run ir bufs n tid)
    (Ifz (Sub n tid) bufs
      (k-run ir (k-run-thread ir bufs tid) n (Add tid 1))))))

; ── Fixture inputs (small integers: f32-exact on the GPU) ──────────────
; m[i] = ((7i) mod 11) - 5;  x row0[j] = ((3j) mod 7) - 3;
; x row1[j] = ((5j) mod 9) - 4 — both sides implement these formulas.

(#bind zz-of
  (#pin (#law "zz-of" (zz-of v ofs)
    (Ifz (Le ofs v) (zz-enc 1 (Sub ofs v)) (zz-enc 0 (Sub v ofs))))))

(#bind m-at
  (#pin (#law "m-at" (m-at i) (zz-of (Mod (Mul 7 i) 11) 5))))

; x is one 64-row, per-thread stride 32: row 0 then row 1
(#bind x-at
  (#pin (#law "x-at" (x-at i)
    j(Mod i 32)
    (Ifz (Div i 32)
      (zz-of (Mod (Mul 3 j) 7) 3)
      (zz-of (Mod (Mul 5 j) 9) 4)))))

(#bind gen-go
  (#pin (#law "gen-go" (gen-go f i n)
    (Ifz (Sub n i) 0 (cell (f i) (gen-go f (Add i 1) n))))))

(#bind cksum-go
  (#pin (#law "cksum-go" (cksum-go r base i)
    (Ifz (Sub 32 i) 0
      (Add (Mul (Add i 1) (Ix (Add base i) r))
           (cksum-go r base (Add i 1)))))))

(#bind main
  (#pin (#law "main" (main args)
    ir(sandwich-ir 0)
    m(Row 0 32 (gen-go m-at 0 32))
    x(Row 0 64 (gen-go x-at 0 64))
    bufs(Row 0 4 (cell m (cell x (cell (Row 0 64 (zeros 64))
                                       (cell (Row 0 64 (zeros 64)) 0)))))
    done(k-run ir bufs 2 0)
    out(Ix 2 done)
    (Trace (Add (Mul (cksum-go out 0 0) 256) 2)
      (Trace (Add (Mul (cksum-go out 32 0) 256) 2) 0)))))

; ── Gap 20: the foil-msl lowering law ──────────────────────────────────
; The same IR, lowered to MSL text: buffers chased from root device
; addresses (b[tid*stride + idx]), registers as float locals, value
; consts decoded from zigzag to signed literals.  One kernel object,
; three tiers: interpreted above, lowered here, C-referenced in the
; fixture.

(#bind Bytes (#pin (#law "Bytes" (Bytes x) ((#pin "B") ("Bytes" x)))))
(#bind Trunc (#pin (#law "Trunc" (Trunc w x) ((#pin "B") ("Trunc" w x)))))
(#bind Lsh (#pin (#law "Lsh" (Lsh a b) ((#pin "B") ("Lsh" a b)))))

(#bind bar
  (#pin (#law "bar" (bar bytes)
    (Add bytes (Lsh 1 (Mul 8 (Bytes bytes)))))))

(#bind bar-len
  (#pin (#law "bar-len" (bar-len b) (Dec (Bytes b)))))

(#bind bar-data
  (#pin (#law "bar-data" (bar-data b)
    (Trunc (Mul 8 (bar-len b)) b))))

(#bind bar-weld
  (#pin (#law "bar-weld" (bar-weld a b)
    (bar (Add (bar-data a)
              (Lsh (bar-data b) (Mul 8 (bar-len a))))))))

(#bind ch (#pin (#law "ch" (ch d) (bar (Add 48 d)))))

(#bind digits
  (#pin (#law "digits" (digits n)
    (Ifz (Div n 10) (ch (Mod n 10))
      (bar-weld (digits (Div n 10)) (ch (Mod n 10)))))))

; zigzag value const -> "N.0f" | "-N.0f"
(#bind fnum
  (#pin (#law "fnum" (fnum z)
    m(digits (zz-mag z))
    (Ifz (zz-sgn z)
      (bar-weld m (bar ".0f"))
      (bar-weld (bar "-") (bar-weld m (bar ".0f")))))))

; value ref -> text
(#bind vtext
  (#pin (#law "vtext" (vtext r)
    k(Mod r 4) v(Div r 4)
    (Ifz k (fnum v)
      (Ifz (Sub k 1)
        (bar-weld (bar "r") (digits v))
        (bar "((float)tid)"))))))

; index ref -> text (raw, not zigzag)
(#bind itext
  (#pin (#law "itext" (itext r)
    k(Mod r 4) v(Div r 4)
    (Ifz k (digits v)
      (Ifz (Sub k 1)
        (bar-weld (bar "(uint)r") (digits v))
        (bar "tid"))))))

; buffer access text: b{slot}[tid*{stride}u + {idx}]
(#bind btext
  (#pin (#law "btext" (btext ir a b)
    bslot(Div a 4)
    stride(Ix bslot (Ix 2 ir))
    pre(bar-weld (bar "b") (bar-weld (digits bslot) (bar "[")))
    idx(itext b)
    (Ifz stride
      (bar-weld pre (bar-weld idx (bar "]")))
      (bar-weld pre
        (bar-weld (bar "tid*")
          (bar-weld (digits stride)
            (bar-weld (bar "u + ") (bar-weld idx (bar "]"))))))))))

(#bind rtext
  (#pin (#law "rtext" (rtext d) (bar-weld (bar "r") (digits d)))))

(#bind asn
  (#pin (#law "asn" (asn d rhs)
    (bar-weld (rtext d)
      (bar-weld (bar " = ") (bar-weld rhs (bar ";
")))))))

(#bind binop
  (#pin (#law "binop" (binop d a opc b)
    (asn d (bar-weld (vtext a) (bar-weld opc (vtext b)))))))

(#bind step-text
  (#pin (#law "step-text" (step-text ir st)
    kind(Ix 0 st) dest(Ix 1 st)
    a(Ix 2 st) b(Ix 3 st) c(Ix 4 st)
    (Ifz kind (asn dest (vtext a))
      (Ifz (Sub kind 1)
        (asn dest (btext ir a b))
      (Ifz (Sub kind 2)
        (bar-weld (btext ir a b)
          (bar-weld (bar " = ") (bar-weld (vtext c) (bar ";
"))))
      (Ifz (Sub kind 3) (binop dest a (bar " + ") b)
      (Ifz (Sub kind 4) (binop dest a (bar " * ") b)
      (Ifz (Sub kind 5)
        (asn dest (bar-weld (bar "-(") (bar-weld (vtext a) (bar ")"))))
      (Ifz (Sub kind 6)
        (asn dest
          (bar-weld (bar "(")
            (bar-weld (vtext a)
              (bar-weld (bar " >= ")
                (bar-weld (vtext b) (bar ") ? 1.0f : 0.0f"))))))
      (Ifz (Sub kind 7)
        (asn dest
          (bar-weld (bar "(")
            (bar-weld (vtext a)
              (bar-weld (bar " != 0.0f) ? ")
                (bar-weld (vtext b)
                  (bar-weld (bar " : ") (vtext c)))))))
        (bar-weld (bar "if (")
          (bar-weld (vtext a) (bar " != 0.0f) return;
"))))))))))))))

(#bind steps-go
  (#pin (#law "steps-go" (steps-go ir i)
    n(Ix 1 ir)
    (Ifz (Sub n i) (bar "")
      (bar-weld (step-text ir (Ix i (Ix 0 ir)))
                (steps-go ir (Add i 1)))))))

(#bind bufdecl-go
  (#pin (#law "bufdecl-go" (bufdecl-go i)
    (Ifz (Sub 4 i) (bar "")
      (bar-weld (bar "device float* b")
        (bar-weld (digits i)
          (bar-weld (bar " = (device float*)(d->b")
            (bar-weld (digits i)
              (bar-weld (bar ");
") (bufdecl-go (Add i 1)))))))))))

(#bind regdecl-go
  (#pin (#law "regdecl-go" (regdecl-go n i)
    (Ifz (Sub n i) (bar "")
      (bar-weld (bar "float r")
        (bar-weld (digits i)
          (bar-weld (bar " = 0.0f;
") (regdecl-go n (Add i 1)))))))))

(#bind lower-msl
  (#pin (#law "lower-msl" (lower-msl ir)
    (bar-weld (bar "#include <metal_stdlib>
using namespace metal;
struct Root { ulong b0; ulong b1; ulong b2; ulong b3; uint count; };
kernel void shrine_kernel_ir(uint tid [[thread_position_in_grid]], const device Root* d [[buffer(0)]]) {
if (tid >= d->count) return;
")
      (bar-weld (bufdecl-go 0)
        (bar-weld (regdecl-go (Ix 3 ir) 0)
          (bar-weld (steps-go ir 0) (bar "}
"))))))))

(#bind lower
  (#pin (#law "lower" (lower args)
    (Trace (lower-msl (sandwich-ir 0)) 0))))
