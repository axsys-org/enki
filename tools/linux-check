#!/bin/sh

set -eu

archive=/tmp/enki-source.tar
workdir=/work

mkdir -p "$workdir"
# make supplies the host's tracked-file list on stdin. Match a local Git
# flake's source selection while reading current working-tree contents:
# scratch files and nested checkouts must not become formatting inputs.
# Ignore missing tracked paths so unstaged deletions are represented too.
tar -C /source \
  --null --no-recursion --ignore-failed-read \
  --exclude='reaver' \
  -cf "$archive" --files-from=-
tar -C "$workdir" -xf "$archive"

exec "$workdir/tools/nix-ci" "path:$workdir"
